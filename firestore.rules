rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Tarkistaa jäsenyyden kotitalouden dokumentista.
    function isHouseholdMember(householdId) {
      return isSignedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/households/$(householdId)
        ).data.memberIds;
    }

    // Tarkistaa omistajuuden kotitalouden ownerId-kentästä.
    function isHouseholdOwner(householdId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/households/$(householdId)
        ).data.ownerId == request.auth.uid;
    }

    // Tarkistaa, että pyynnön tekijä omistaa poistettavan kotitalouden.
    function ownsDeletingHousehold(householdId) {
      let household = get(
        /databases/$(database)/documents/households/$(householdId)
      ).data;

      return isSignedIn()
        && household.ownerId == request.auth.uid
        && household.get('isDeleting', false) == true;
    }

    // Tarkistaa kotitalouden poistotilan kirjoituksen jälkeen.
    function isHouseholdActiveAfter(householdId) {
      return getAfter(
        /databases/$(database)/documents/households/$(householdId)
      ).data.get('isDeleting', false) == false;
    }

    // Ruokinnan voi kirjata vain saman kotitalouden aktiiviselle lemmikille.
    function isActivePetAfter(petId, householdId) {
      let pet = getAfter(
        /databases/$(database)/documents/pets/$(petId)
      ).data;

      return pet.householdId == householdId
        && pet.get('isDeleting', false) == false;
    }

    // Omistaja voi tyhjentää yksittäisen lemmikin historian poiston alettua.
    function canDeletePetFeeding(petId, householdId) {
      let pet = get(
        /databases/$(database)/documents/pets/$(petId)
      ).data;

      return isHouseholdOwner(householdId)
        && pet.householdId == householdId
        && pet.get('isDeleting', false) == true;
    }

    match /households/{householdId} {

      // Sallii omistajan vaihtaa vain kotitalouden nimen.
      function isOwnerRename() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80;
      }

      // Sallii omistajan käynnistää poiston muuttamatta muita tietoja.
      function isOwnerStartingDeletion() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isDeleting'])
          && request.resource.data.isDeleting == true;
      }

      // Tarkistaa käyttäjän toimittaman koodin ja liittymispyynnön rakenteen.
      function hasValidJoinRequest() {
        return 'joinCode' in resource.data
          && resource.data.joinCode is string
          && 'lastJoinRequest' in request.resource.data
          && request.resource.data.lastJoinRequest is map
          && request.resource.data.lastJoinRequest.keys().hasAll([
            'userId', 'code'
          ])
          && request.resource.data.lastJoinRequest.keys().hasOnly([
            'userId', 'code'
          ])
          && request.resource.data.lastJoinRequest.userId
            == request.auth.uid
          && request.resource.data.lastJoinRequest.code is string
          && request.resource.data.lastJoinRequest.code
            == resource.data.joinCode;
      }

      // Sallii oman jäsenyyden lisäämisen säilyttäen nykyiset jäsenet.
      // Uudelleen liittyminen ei lisää samaa käyttäjää toista kertaa.
      function isJoiningWithCode() {
        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberIds', 'lastJoinRequest'])
          && hasValidJoinRequest()
          && request.resource.data.memberIds is list
          && (
            (
              !(request.auth.uid in resource.data.memberIds)
              && request.resource.data.memberIds
                == resource.data.memberIds.concat([request.auth.uid])
            )
            ||
            (
              request.auth.uid in resource.data.memberIds
              && request.resource.data.memberIds
                == resource.data.memberIds
            )
          );
      }

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      // Kotitalous ja sen koodivaraus luodaan yhdessä.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'name', 'ownerId', 'memberIds', 'joinCode', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'memberIds', 'joinCode', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.matches(
          '^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$'
        )
        && !exists(
          /databases/$(database)/documents/householdInvites/$(request.resource.data.joinCode)
        )
        && getAfter(
          /databases/$(database)/documents/householdInvites/$(request.resource.data.joinCode)
        ).data.householdId == householdId;

      allow update: if isSignedIn()
        && resource.data.get('isDeleting', false) == false
        && (
          isOwnerRename()
          || isOwnerStartingDeletion()
          || isJoiningWithCode()
        );

      // Kotitalouden mahdollinen koodivaraus poistetaan samalla.
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('isDeleting', false) == true
        && (
          !('joinCode' in resource.data)
          || !existsAfter(
            /databases/$(database)/documents/householdInvites/$(resource.data.joinCode)
          )
        );
    }

    match /householdInvites/{joinCode} {

      // Kirjautunut käyttäjä voi tarkistaa yksittäisen koodin.
      allow get: if isSignedIn();
      allow list: if false;

      // Koodivaraus saa osoittaa vain samalla kertaa luotavaan omaan kotitalouteen.
      allow create: if isSignedIn()
        && joinCode.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$')
        && request.resource.data.keys().hasAll(['householdId'])
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && !exists(
          /databases/$(database)/documents/households/$(request.resource.data.householdId)
        )
        && getAfter(
          /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.ownerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.joinCode == joinCode;

      allow update: if false;

      allow delete: if ownsDeletingHousehold(resource.data.householdId)
        && !existsAfter(
          /databases/$(database)/documents/households/$(resource.data.householdId)
        );
    }

    match /pets/{petId} {

      // Jäsen voi muokata lemmikin nimeä, lajia ja ruokintatavoitetta.
      function isPetDetailsUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();

        return changed.hasOnly(['name', 'species', 'feedingsPerDay'])
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 80
          && data.species is string
          && data.species.size() >= 1
          && data.species.size() <= 40
          && data.feedingsPerDay is int
          && data.feedingsPerDay >= 1
          && data.feedingsPerDay <= 24;
      }

      // Uusi kuva korvaa aiemman kuvan samassa kentässä.
      function isPetPhotoUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();

        return changed.hasOnly(['photo'])
          && 'photo' in data
          && data.photo is bytes
          && data.photo.size() > 0
          && data.photo.size() <= 204800;
      }

      // Omistaja voi käynnistää lemmikin poiston asettamalla poistotilan.
      function isOwnerStartingPetDeletion() {
        return isHouseholdOwner(resource.data.householdId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isDeleting'])
          && request.resource.data.isDeleting == true;
      }

      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.species is string
        && request.resource.data.species.size() >= 1
        && request.resource.data.species.size() <= 40
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId)
        && isHouseholdActiveAfter(request.resource.data.householdId)
        && request.resource.data.feedingsPerDay is int
        && request.resource.data.feedingsPerDay >= 1
        && request.resource.data.feedingsPerDay <= 24
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Muokkaus ja kuvanvaihto ovat sallittuja vain aktiiviselle lemmikille.
      allow update: if isHouseholdMember(resource.data.householdId)
        && isHouseholdActiveAfter(resource.data.householdId)
        && resource.data.get('isDeleting', false) == false
        && (
          isPetDetailsUpdate()
          || isPetPhotoUpdate()
          || isOwnerStartingPetDeletion()
        );

      // Omistaja voi viimeistellä kotitalouden tai yksittäisen lemmikin poiston.
      allow delete: if ownsDeletingHousehold(resource.data.householdId)
        || (
          resource.data.get('isDeleting', false) == true
          && isHouseholdOwner(resource.data.householdId)
        );
    }

    match /feedings/{feedingId} {

      // Tarkistaa ajan lemmikin nykyisestä tavoitteesta ja sitoo sen dokumentin tunnisteeseen.
      function isScheduledSlot() {
        let data = request.resource.data;
        let count = getAfter(
          /databases/$(database)/documents/pets/$(data.petId)
        ).data.feedingsPerDay;
        let civilMidnight = data.scheduleDay * 86400000;

        return data.slotIndex is int
          && data.slotIndex >= 0
          && data.slotIndex < count
          && data.scheduledMinute is int
          && data.scheduledMinute == 15 * math.round(96.0 * data.slotIndex / count)
          && data.scheduleDay is int
          && data.dayStart is timestamp
          && data.dayEnd is timestamp
          && ((civilMidnight - data.dayStart.toMillis()) in [7200000, 10800000])
          && ((civilMidnight + 86400000 - data.dayEnd.toMillis()) in [7200000, 10800000])
          && data.dayStart <= request.time
          && request.time < data.dayEnd
          && feedingId == data.petId + '_' + string(data.scheduleDay) + '_' + string(data.scheduledMinute);
      }

      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'petId', 'householdId', 'fedBy', 'fedAt',
          'scheduledMinute', 'scheduleDay', 'slotIndex', 'dayStart', 'dayEnd'
        ])
        && request.resource.data.keys().hasOnly([
          'petId', 'householdId', 'fedBy', 'fedAt',
          'scheduledMinute', 'scheduleDay', 'slotIndex', 'dayStart', 'dayEnd'
        ])
        && request.resource.data.petId is string
        && request.resource.data.petId.size() > 0
        && request.resource.data.householdId is string
        && request.resource.data.householdId.size() > 0
        && request.resource.data.fedBy == request.auth.uid
        && request.resource.data.fedAt == request.time
        && isHouseholdMember(request.resource.data.householdId)
        && isHouseholdActiveAfter(request.resource.data.householdId)
        && isScheduledSlot()
        && isActivePetAfter(
          request.resource.data.petId,
          request.resource.data.householdId
        );

      allow update: if false;

      allow delete: if ownsDeletingHousehold(resource.data.householdId)
        || canDeletePetFeeding(
          resource.data.petId,
          resource.data.householdId
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}