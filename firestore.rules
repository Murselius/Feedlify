rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Tarkistaa jäsenyyden kotitalouden dokumentista.
    function isHouseholdMember(householdId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId))
            .data.memberIds;
    }

    match /households/{householdId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'name', 'ownerId', 'memberIds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'memberIds', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /pets/{petId} {
      // Vain lemmikin kotitalouden jäsen voi lukea tiedot.
      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.species is string
        && request.resource.data.species.size() >= 1
        && request.resource.data.species.size() <= 40
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId)
        && request.resource.data.feedingsPerDay is int
        && request.resource.data.feedingsPerDay >= 1
        && request.resource.data.feedingsPerDay <= 24
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}