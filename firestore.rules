rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Tarkistaa jäsenyyden kotitalouden dokumentista.
    function isHouseholdMember(householdId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId))
            .data.memberIds;
    }

    // Tarkistaa, että pyynnön tekijä omistaa poistettavan kotitalouden.
    function ownsDeletingHousehold(householdId) {
    let household = get(
        /databases/$(database)/documents/households/$(householdId)
    ).data;

    return isSignedIn()
        && household.ownerId == request.auth.uid
        && household.get('isDeleting', false) == true;
    }

    // Tarkistaa kotitalouden poistotilan myös saman kirjoituksen muutosten jälkeen.
    function isHouseholdActiveAfter(householdId) {
    return getAfter(
        /databases/$(database)/documents/households/$(householdId)
    ).data.get('isDeleting', false) == false;
    }

   match /households/{householdId} {
    allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

    // Kotitalous ja sen koodivaraus on luotava yhdessä.
    allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
        'name', 'ownerId', 'memberIds', 'joinCode', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
        'name', 'ownerId', 'memberIds', 'joinCode', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.matches(
        '^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$'
        )
        && !exists(
        /databases/$(database)/documents/householdInvites/$(request.resource.data.joinCode)
        )
        && getAfter(
        /databases/$(database)/documents/householdInvites/$(request.resource.data.joinCode)
        ).data.householdId == householdId;

        // Omistaja voi joko muuttaa nimeä tai käynnistää poiston.
        // Poistotilaa ei voi perua eikä muita kenttiä muuttaa.
        allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('isDeleting', false) == false
        && (
            (
            request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 80
            )
            ||
            (
            request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['isDeleting'])
            && request.resource.data.isDeleting == true
            )
        );

        // Kotitalouden mahdollinen koodivaraus poistetaan samalla.
        allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('isDeleting', false) == true
        && (
            !('joinCode' in resource.data)
            || !existsAfter(
            /databases/$(database)/documents/householdInvites/$(resource.data.joinCode)
            )
        );
    }

    match /householdInvites/{joinCode} {
    // Kirjautunut käyttäjä voi tarkistaa yksittäisen koodin.
    allow get: if isSignedIn();
    allow list: if false;

    // Koodivaraus saa osoittaa vain samalla kertaa luotavaan omaan kotitalouteen.
    allow create: if isSignedIn()
        && joinCode.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$')
        && request.resource.data.keys().hasAll(['householdId'])
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && !exists(
        /databases/$(database)/documents/households/$(request.resource.data.householdId)
        )
        && getAfter(
        /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.ownerId == request.auth.uid
        && getAfter(
        /databases/$(database)/documents/households/$(request.resource.data.householdId)
        ).data.joinCode == joinCode;

    allow update: if false;

    // Varauksen voi poistaa vain omistaja kotitalouden lopullisen poiston yhteydessä.
    allow delete: if ownsDeletingHousehold(resource.data.householdId)
    && !existsAfter(
        /databases/$(database)/documents/households/$(resource.data.householdId)
    );
    }

    match /pets/{petId} {
      // Vain lemmikin kotitalouden jäsen voi lukea tiedot.
      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'species', 'householdId',
          'feedingsPerDay', 'createdBy', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.species is string
        && request.resource.data.species.size() >= 1
        && request.resource.data.species.size() <= 40
        && request.resource.data.householdId is string
        && isHouseholdMember(request.resource.data.householdId)
        && isHouseholdActiveAfter(request.resource.data.householdId)
        && request.resource.data.feedingsPerDay is int
        && request.resource.data.feedingsPerDay >= 1
        && request.resource.data.feedingsPerDay <= 24
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      // Omistaja voi poistaa lemmikit osana kotitalouden poistamista.
      allow delete: if ownsDeletingHousehold(resource.data.householdId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}